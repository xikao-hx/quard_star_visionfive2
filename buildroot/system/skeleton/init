#!/bin/sh

mount -t proc proc /proc
ROOT=
NFSROOT=
export init=/sbin/init
for x in $(cat /proc/cmdline); do
	case $x in
		init=*)
			init=${x#init=}
			;;
		root=*)
			ROOT=${x#root=}
			;;
		nfsroot=*)
			NFSROOT=${x#nfsroot=}
			;;
	esac
done

mount -t sysfs sysfs /sys

mount -t devtmpfs -o nosuid,mode=0755 devtmpfs /dev

mkdir -p /dev/pts
mkdir -p /dev/shm
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /dev/shm
mount -t tmpfs tmpfs /tmp
mount -t tmpfs tmpfs /run

if [ "x${ROOT}" = "x" ]; then
	exec /sbin/init
fi

export ROOT

mkdir /rootfs
if [ "$ROOT" = "/dev/nfs" ] && [ "x${NFSROOT}" != "x" ]; then
	/sbin/ifup -a
	mount -t nfs -o nolock "$NFSROOT" /rootfs
else
	ROOT_DEVICE="$ROOT"
	cnt=0
	while [ "$cnt" -lt 100 ]
	do
		case "$ROOT" in
			PARTUUID=*)
				# BusyBox blkid does not report GPT PARTUUIDs. The
				# initramfs includes util-linux blkid for this lookup.
				ROOT_DEVICE=$(/sbin/blkid -t "$ROOT" -o device 2>/dev/null)
				;;
			*)
				ROOT_DEVICE="$ROOT"
				;;
		esac

		if [ -n "$ROOT_DEVICE" ] && [ -b "$ROOT_DEVICE" ]; then
			echo "find $ROOT as $ROOT_DEVICE: $cnt"
			break
		fi

		ROOT_DEVICE=
		sleep 0.1
		cnt=$((cnt + 1))
	done

	if [ -z "$ROOT_DEVICE" ]; then
		echo "ERROR: root device $ROOT was not found" >&2
		exit 1
	fi
	if ! mount "$ROOT_DEVICE" /rootfs/; then
		echo "ERROR: failed to mount $ROOT_DEVICE as root" >&2
		exit 1
	fi
	if [ ! -e /rootfs/dev/console ]; then
		/bin/mknod /rootfs/dev/console c 5 1
	fi
	if [ ! -e /rootfs/dev/null ]; then
		/bin/mknod /rootfs/dev/null c 1 3
	fi
fi

mount -n -o move /proc /rootfs/proc
mount -n -o move /sys /rootfs/sys
mount -n -o move /run /rootfs/run
mount -n -o move /tmp /rootfs/tmp
# Moving devtmpfs also moves its /dev/shm and /dev/pts child mounts.
mount -n -o move /dev /rootfs/dev

exec run-init /rootfs "${init}" "$@" <"/rootfs/dev/console" >"/rootfs/dev/console" 2>&1
echo "Something went badly wrong in the initramfs."
